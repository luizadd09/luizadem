---
/**
 * Square software icon with a hover label.
 * Uses src/assets/software/<id>.svg when it exists, otherwise a placeholder
 * showing the abbreviation (Ps, Ai, …).
 */
import { getSoftware } from '../data/software.js';

const { id } = Astro.props;
const { name, abbr } = getSoftware(id);

const icons = import.meta.glob('../assets/software/*.svg', { eager: true, import: 'default' });
const icon = icons[`../assets/software/${id}.svg`];
---

<span class:list={['software', { 'software--placeholder': !icon }]} data-name={name}>
	{icon ? <img src={icon.src} alt="" width="40" height="40" loading="lazy" /> : <span aria-hidden="true">{abbr}</span>}
	<span class="visually-hidden">{name}</span>
</span>

<style>
	.software {
		position: relative;
		display: grid;
		place-items: center;
		inline-size: 2.5rem;
		aspect-ratio: 1;

		& img {
			inline-size: 100%;
			block-size: 100%;
			object-fit: contain;
		}

		/* Name label on hover/focus of the surrounding item. */
		&::after {
			content: attr(data-name);
			position: absolute;
			inset-block-start: calc(100% + 0.4rem);
			inset-inline-start: 50%;
			z-index: 2;
			padding: 0.2rem 0.5rem;
			background: var(--color-ink);
			color: var(--color-bg);
			font-family: var(--font-mono-stack);
			font-size: var(--step--1);
			white-space: nowrap;
			pointer-events: none;
			opacity: 0;
			translate: -50% -0.25rem;
			transition:
				opacity 0.25s var(--ease-out),
				translate 0.25s var(--ease-out);
		}

		&:hover::after {
			opacity: 1;
			translate: -50% 0;
		}
	}

	.software--placeholder {
		border: 1px solid var(--color-ink);
		border-radius: 0.5rem;
		background: var(--color-bg);
		font-family: var(--font-mono-stack);
		font-size: var(--step-0);
		font-weight: 500;
		letter-spacing: -0.02em;
		transition:
			background-color 0.3s var(--ease-out),
			color 0.3s var(--ease-out);

		&:hover {
			background: var(--color-ink);
			color: var(--color-bg);
		}
	}
</style>
