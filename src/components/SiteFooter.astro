---
import { site } from '../data/site.js';

const year = new Date().getFullYear();
---

<!-- Full-bleed band; the inner .sheet keeps content aligned with the page above. -->
<footer class="footer" id="contact" data-surface="dark">
	<div class="footer__inner sheet" data-animate="fade-up">
		<div class="footer__contact">
			<h2 class="footer__title">Let’s work together</h2>
			<a class="footer__email" href={`mailto:${site.email}`}>{site.email}</a>
		</div>

		<ul class="footer__links" role="list">
			{
				site.socials.map((social) => (
					<li>
						<a class="btn" href={social.href} rel="noopener" target="_blank">
							<span aria-hidden="true">//</span>
							{social.label}
						</a>
					</li>
				))
			}
		</ul>

		<p class="footer__legal">© {year} {site.name}</p>
	</div>
</footer>

<style>
	.footer {
		background: var(--color-dark);
		color: var(--color-on-dark);
	}

	.footer__inner {
		display: grid;
		gap: var(--space-s) var(--space-m);
		padding-block: var(--space-m) var(--space-s);

		@media (width >= 48rem) {
			grid-template-columns: 1fr auto;
			align-items: center;
		}
	}

	.footer__contact {
		display: grid;
		gap: 0.35rem;
	}

	.footer__title {
		font-size: var(--step-1);
	}

	.footer__email {
		font-family: var(--font-mono-stack);
		font-size: var(--step--1);
		justify-self: start;
	}

	.footer__links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;

		& .btn {
			--color-ink: var(--color-on-dark);
			--color-bg: var(--color-dark);
		}
	}

	.footer__legal {
		grid-column: 1 / -1;
		padding-block-start: var(--space-s);
		border-block-start: 1px solid color-mix(in oklab, var(--color-on-dark) 15%, transparent);
		font-family: var(--font-mono-stack);
		font-size: var(--step--1);
		color: color-mix(in oklab, var(--color-on-dark) 70%, transparent);
	}
</style>
